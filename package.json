{
  "name": "drift-minigame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/static-server.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 delete drift-minigame",
    "deploy:production": "bash scripts/deploy-production.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "lil-gui": "^0.20.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  }
}
